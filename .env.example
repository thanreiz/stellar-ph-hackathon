# =============================================================
# SariSync Ledger — Environment Configuration
# =============================================================
# Copy this file to .env before running the app:
#   cp .env.example .env
#
# HACKATHON MVP SECURITY NOTE:
# EXPO_PUBLIC_* variables are compiled into the JavaScript bundle
# at build time and are readable by anyone who inspects the bundle.
# This is an accepted trade-off for the hackathon demo only.
# Production replacement: Soroban Smart Contract multi-sig passkey
# authentication (documented in PRD Section 10 Future Enhancements).
# =============================================================

# Your Stellar Testnet keypair.
# Generate one at: https://laboratory.stellar.org/#account-creator?network=testnet
EXPO_PUBLIC_STORE_SECRET_KEY=
EXPO_PUBLIC_STORE_PUBLIC_KEY=

# Partner lender signing keys (Stellar Testnet).
# These sign the demo microloan disbursements. Generate two testnet keypairs and
# fund them with PHPC via `npm run seed:lenders`. Their public keys + amounts live
# in lenders.example.json (copy it to lenders.json, which is gitignored).
EXPO_PUBLIC_LENDER_1_SECRET=
EXPO_PUBLIC_LENDER_2_SECRET=

# Asset issuers on Stellar Testnet.
# PHPC = Philippine Peso Coin (send asset)
# USDC = USD Coin (destination asset)
EXPO_PUBLIC_PHPC_ISSUER=
EXPO_PUBLIC_USDC_ISSUER=

# Deployed Soroban credit-profile contract id (see scripts/deployContract.js).
EXPO_PUBLIC_SOROBAN_CONTRACT_ID=

# Network config — use 'testnet' for development and 'public' for mainnet.
EXPO_PUBLIC_STELLAR_NETWORK=testnet
EXPO_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
EXPO_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

